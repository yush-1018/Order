# OrderPay Environment Variables Example
# Copy this file to server/.env and fill in your keys

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/orderpay
JWT_SECRET=your_jwt_secret_key_change_in_production

# Gnani AI API Credentials (get from https://vachana.ai)
GNANI_API_KEY=your_gnani_vachana_api_key_here
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_VOICE=Nalini
